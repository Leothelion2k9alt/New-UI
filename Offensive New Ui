local clickTeleportMode    = "Ground"               -- "Ground" or "Part"
local clickTeleportConnection = nil

local clickIndicator = Drawing.new("Circle")
clickIndicator.Visible = false; clickIndicator.Thickness = 2
clickIndicator.Color = Color3.fromRGB(0, 200, 255); clickIndicator.Filled = false
clickIndicator.Transparency = 1; clickIndicator.NumSides = 32; clickIndicator.Radius = 8

Tabs.Movement:CreateToggle({ Name = "Enable Click Teleport", CurrentValue = false, Flag = "ClickTeleportToggle",
	Callback = function(v)
		clickTeleportEnabled = v
		if v then
			clickTeleportConnection = UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe then return end
				if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
				if not clickTeleportEnabled then return end
				local root = getRoot()
				if not root then return end
				local unitRay = Camera:ScreenPointToRay(input.Position.X, input.Position.Y)
				local params = RaycastParams.new()
				params.FilterDescendantsInstances = { getCharacter() }
				params.FilterType = Enum.RaycastFilterType.Exclude
				local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, params)
				if result then
					local targetPos = result.Position
					if clickTeleportMode == "Ground" then
						targetPos = targetPos + Vector3.new(0, root.Size.Y / 2 + 0.1, 0)
					else
						targetPos = targetPos + clickTeleportOffset
					end
					root.CFrame = CFrame.new(targetPos, targetPos + Camera.CFrame.LookVector)
					-- Flash indicator
					local screenPos = Camera:WorldToViewportPoint(targetPos)
					clickIndicator.Position = Vector2.new(screenPos.X, screenPos.Y)
					clickIndicator.Visible = true
					task.delay(0.3, function() clickIndicator.Visible = false end)
				end
			end)
			Rayfield:Notify({Title = "Click Teleport", Content = "Click anywhere to teleport there!", Duration = 3})
		else
			if clickTeleportConnection then clickTeleportConnection:Disconnect(); clickTeleportConnection = nil end
			clickIndicator.Visible = false
			Rayfield:Notify({Title = "Click Teleport", Content = "Click teleport disabled!", Duration = 2})
		end
	end })

