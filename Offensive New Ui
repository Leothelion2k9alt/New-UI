local function formatPlayerName(player)
	local dn, un = player.DisplayName, player.Name
	if dn == un then return un end
	local full = dn .. " (" .. un .. ")"
	if #full > 30 then
		local maxD = 30 - #un - 3
		if maxD < 3 then return string.sub(un, 1, 27) .. "..." end
		return string.sub(dn, 1, maxD) .. ".. (" .. un .. ")"
	end
	return full
end

local function refreshPlayerList()
	local displayNames = {}
	teleportPlayerMap = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local formatted = formatPlayerName(player)
			table.insert(displayNames, formatted)
			teleportPlayerMap[formatted] = player.Name
		end
	end
	if #displayNames == 0 then
		if teleportDropdown then teleportDropdown:Refresh({"No players in server"}, true) end
		selectedTeleportPlayer = nil
		Rayfield:Notify({Title = "Server", Content = "No players in server!", Duration = 2})
		return
	end
	local prev = selectedTeleportPlayer
	if teleportDropdown then teleportDropdown:Refresh(displayNames, true) end
	local found = nil
	for dn, un in pairs(teleportPlayerMap) do
		if un == prev then found = dn; break end
	end
	if not found then
		if prev then Rayfield:Notify({Title = "Player Left", Content = prev .. " left!", Duration = 2}) end
		selectedTeleportPlayer = teleportPlayerMap[displayNames[1]]
	end
end

