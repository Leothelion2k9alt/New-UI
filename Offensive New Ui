Tabs.Ui:CreateSection("Preset Colors")

local currentUIColor    = Color3.fromRGB(255,255,255)
local rainbowUIEnabled  = false
local rainbowUIConnection = nil

local function applyUIColor(color)
	pcall(function() Rayfield:SetAccentColor(color) end)
	for _, text in pairs(espTexts) do pcall(function() if text then text.Color = color end end) end
	for _, box  in pairs(espBoxes)  do pcall(function() if box  then box.Color  = color end end) end
	for _, cham in pairs(espChams)  do pcall(function()
		if cham then cham.FillColor = color; cham.OutlineColor = color end
	end) end
	pcall(function() fovCircle.Color = color end)
end

local uiColors = {
	White = Color3.fromRGB(255,255,255), Red    = Color3.fromRGB(255,50,50),
	Green = Color3.fromRGB(50,255,100),  Blue   = Color3.fromRGB(50,150,255),
	Purple= Color3.fromRGB(180,50,255),  Pink   = Color3.fromRGB(255,100,200),
	Orange= Color3.fromRGB(255,150,50),  Yellow = Color3.fromRGB(255,220,50),
	Cyan  = Color3.fromRGB(50,220,255),
}

Tabs.Ui:CreateDropdown({ Name = "Preset Color", Options = {"White","Red","Green","Blue","Purple","Pink","Orange","Yellow","Cyan","Rainbow"}, CurrentOption = {"White"}, Flag = "UIColorDropdown",
	Callback = function(o)
		local picked = o[1]
		if picked == "Rainbow" then
			rainbowUIEnabled = true
			if rainbowUIConnection then rainbowUIConnection:Disconnect() end
			rainbowUIConnection = RunService.Heartbeat:Connect(function()
				if rainbowUIEnabled then applyUIColor(Color3.fromHSV(tick() % 5 / 5, 1, 1)) end
			end)
		else
			rainbowUIEnabled = false
			if rainbowUIConnection then rainbowUIConnection:Disconnect(); rainbowUIConnection = nil end
			local color = uiColors[picked]
			if color then currentUIColor = color; applyUIColor(color) end
		end
		Rayfield:Notify({Title = "UI Color", Content = "Color: " .. picked, Duration = 2})
	end })

Tabs.Ui:CreateSection("Custom RGB")

local rVal, gVal, bVal = 255, 255, 255

local function applyRGB()
	rainbowUIEnabled = false
	if rainbowUIConnection then rainbowUIConnection:Disconnect(); rainbowUIConnection = nil end
	currentUIColor = Color3.fromRGB(rVal, gVal, bVal)
	applyUIColor(currentUIColor)
end

Tabs.Ui:CreateSlider({ Name = "Red",   Range = {0,255}, Increment = 1, Suffix = "", CurrentValue = 255, Flag = "UIColorR", Callback = function(v) rVal = v; applyRGB() end })
Tabs.Ui:CreateSlider({ Name = "Green", Range = {0,255}, Increment = 1, Suffix = "", CurrentValue = 255, Flag = "UIColorG", Callback = function(v) gVal = v; applyRGB() end })
Tabs.Ui:CreateSlider({ Name = "Blue",  Range = {0,255}, Increment = 1, Suffix = "", CurrentValue = 255, Flag = "UIColorB", Callback = function(v) bVal = v; applyRGB() end })

