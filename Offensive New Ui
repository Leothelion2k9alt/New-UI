local function getOrCreateDot(index)
	if not radarDots[index] then
		local dot = Drawing.new("Circle")
		dot.Visible = false; dot.Thickness = 1; dot.Color = Color3.fromRGB(255,50,50)
		dot.Filled = true; dot.Transparency = 1; dot.NumSides = 16; dot.Radius = 5
		radarDots[index] = dot
		local name = Drawing.new("Text")
		name.Visible = false; name.Color = Color3.fromRGB(255,255,255); name.Size = 12
		name.Center = true; name.Outline = true; name.Transparency = 1; name.Font = 2
		radarNames[index] = name
		local line = Drawing.new("Line")
		line.Visible = false; line.Color = Color3.fromRGB(255,50,50); line.Thickness = 1; line.Transparency = 0.5
		radarLines[index] = line
	end
	return radarDots[index], radarNames[index], radarLines[index]
end

local function hideDotsFrom(index)
	for i = index, #radarDots do
		if radarDots[i]  then radarDots[i].Visible  = false end
		if radarNames[i] then radarNames[i].Visible = false end
		if radarLines[i] then radarLines[i].Visible = false end
	end
end

