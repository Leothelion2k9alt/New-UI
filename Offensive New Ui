-- Ice Physics
Tabs.Movement:CreateSection("Ice Physics")

local iceEnabled = false; local iceConnection = nil; local defaultFriction = {}

local function applyIce(enabled)
	pcall(function()
		local character = getCharacter(); if not character then return end
		for _, v in ipairs(character:GetDescendants()) do
			if v:IsA("BasePart") then
				if enabled then
					defaultFriction[v] = { friction = (v.CustomPhysicalProperties and v.CustomPhysicalProperties.Friction) or 0.3 }
					v.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.0, 0.0, 0.0, 0.0)
				else
					v.CustomPhysicalProperties = PhysicalProperties.new(0.3, (defaultFriction[v] and defaultFriction[v].friction) or 0.3, 0.5, 0.0, 0.0)
				end
			end
		end
	end)
end

