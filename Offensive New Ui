local freeCamEnabled   = false; local freeCamSpeed = 50; local freeCamConnection = nil
local originalCameraSubject = nil

Tabs.Movement:CreateToggle({ Name = "Free Cam", CurrentValue = false, Flag = "FreeCamToggle",
	Callback = function(v)
		freeCamEnabled = v
		if v then
			originalCameraSubject = Camera.CameraSubject
			Camera.CameraType = Enum.CameraType.Scriptable
			local rotX, rotY = 0, 0
			local _, ry, rx = Camera.CFrame:ToEulerAnglesYXZ()
			rotX = ry; rotY = rx
			freeCamConnection = RunService.Heartbeat:Connect(function()
				if not freeCamEnabled then return end
				if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
					UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
					local delta = UserInputService:GetMouseDelta()
					rotX = rotX - math.rad(delta.X * 0.3)
					rotY = math.clamp(rotY - math.rad(delta.Y * 0.3), math.rad(-89), math.rad(89))
				else
					UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				end
				local newCFrame = CFrame.new(Camera.CFrame.Position) * CFrame.Angles(0, rotX, 0) * CFrame.Angles(rotY, 0, 0)
				local moveDir = Vector3.zero
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += newCFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= newCFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= newCFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += newCFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0,1,0) end
				local newPos = Camera.CFrame.Position
				if moveDir.Magnitude > 0 then newPos = newPos + moveDir.Unit * (freeCamSpeed * 0.016) end
				Camera.CFrame = CFrame.new(newPos) * CFrame.Angles(0, rotX, 0) * CFrame.Angles(rotY, 0, 0)
			end)
			Rayfield:Notify({Title = "Free Cam", Content = "Hold Right Mouse to look, WASD to move!", Duration = 4})
		else
			if freeCamConnection then freeCamConnection:Disconnect(); freeCamConnection = nil end
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			Camera.CameraType = Enum.CameraType.Custom
			if originalCameraSubject then Camera.CameraSubject = originalCameraSubject end
			Rayfield:Notify({Title = "Free Cam", Content = "Free cam disabled!", Duration = 2})
		end
	end })

