				local sPos, sOn = Camera:WorldToViewportPoint(a.Position)
				local ePos, eOn = Camera:WorldToViewportPoint(b.Position)
				if sOn and eOn and line then
					line.From = Vector2.new(sPos.X, sPos.Y); line.To = Vector2.new(ePos.X, ePos.Y)
					line.Visible = true
					if rainbowModeEnabled then line.Color = rainbowColor end
				elseif line then line.Visible = false end
			elseif line then line.Visible = false end
		end
		if skeletonESPTracers then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				local rPos, onScreen = Camera:WorldToViewportPoint(root.Position)
				if onScreen then
					if not skeletonLines[player].tracer then
						local tr = Drawing.new("Line")
						tr.Thickness = 2; tr.Transparency = 1; tr.Color = Color3.new(1,1,1)
						skeletonLines[player].tracer = tr
					end
					local tr = skeletonLines[player].tracer
					tr.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					tr.To = Vector2.new(rPos.X, rPos.Y); tr.Visible = true
					if rainbowModeEnabled then tr.Color = rainbowColor end
				else
					if skeletonLines[player].tracer then skeletonLines[player].tracer.Visible = false end
				end
			end
		else
			if skeletonLines[player] and skeletonLines[player].tracer then skeletonLines[player].tracer.Visible = false end
