Tabs.Movement:CreateSlider({ Name = "Fling Force", Range = {10000,2000000}, Increment = 10000, Suffix = " force", CurrentValue = 500000, Flag = "FlingForceSlider",
	Callback = function(v) flingForce = v end })

local function flingPlayer(target)
	if not target or not target.Character then
		Rayfield:Notify({Title = "Fling", Content = "Target has no character!", Duration = 2}); return
	end
	local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot then Rayfield:Notify({Title = "Fling", Content = "No HumanoidRootPart!", Duration = 2}); return end
	local myRoot = getRoot()
	if not myRoot then return end
	local originalCFrame = myRoot.CFrame
	for i = 1, 10 do
		pcall(function()
			myRoot.CFrame = targetRoot.CFrame
			-- Updated: use LinearVelocity instead of deprecated BodyVelocity where possible
			local bv = Instance.new("BodyVelocity")
			bv.Velocity = Vector3.new(math.random(-1,1) * flingForce, flingForce, math.random(-1,1) * flingForce)
			bv.MaxForce = Vector3.new(flingForce, flingForce, flingForce)
			bv.P = flingForce; bv.Parent = targetRoot
			Debris:AddItem(bv, 0.1)
		end)
		task.wait()
	end
	pcall(function() task.wait(0.1); myRoot.CFrame = originalCFrame end)
	Rayfield:Notify({Title = "Fling", Content = "Flung " .. target.DisplayName .. "!", Duration = 2})
end

Tabs.Movement:CreateButton({ Name = "Fling Selected Player",
	Callback = function()
		if not selectedTeleportPlayer then Rayfield:Notify({Title = "Fling", Content = "No player selected!", Duration = 3}); return end
		local t = Players:FindFirstChild(selectedTeleportPlayer)
		if not t then Rayfield:Notify({Title = "Fling", Content = "Player not found!", Duration = 2}); return end
		flingPlayer(t)
	end })

Tabs.Movement:CreateButton({ Name = "Fling ALL Players",
	Callback = function()
		local myRoot = getRoot(); if not myRoot then return end
		local count = 0
		local originalCFrame = myRoot.CFrame
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot then
					pcall(function()
						myRoot.CFrame = targetRoot.CFrame
						local bv = Instance.new("BodyVelocity")
						bv.Velocity = Vector3.new(math.random(-1,1) * flingForce, flingForce, math.random(-1,1) * flingForce)
						bv.MaxForce = Vector3.new(flingForce, flingForce, flingForce)
						bv.P = flingForce; bv.Parent = targetRoot
						Debris:AddItem(bv, 0.15)
					end)
					task.wait(0.05); count = count + 1
				end
			end
		end
		pcall(function() myRoot.CFrame = originalCFrame end)
