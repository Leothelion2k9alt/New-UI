connections["Radar"] = RunService.Heartbeat:Connect(function()
	if not radarEnabled then return end
	local myRoot = getRoot()
	if not myRoot then return end
	local radius = radarSize / 2
	local centerX = radarX + radius; local centerY = radarY + radius
	local center = Vector2.new(centerX, centerY)
	local hue = tick() % 5 / 5
	local rainbowColor = Color3.fromHSV(hue, 1, 1)
	radarCircle.Position = center; radarCircle.Radius = radius
	radarBorder.Position = center; radarBorder.Radius = radius
	radarBorder.Color = radarRainbow and rainbowColor or Color3.fromRGB(255,255,255)
	radarCenterDot.Position = center
	radarLabel.Position = Vector2.new(centerX, radarY + radius * 2 + 5)
	radarNorth.Position = Vector2.new(centerX, radarY - 16)
	radarNorth.Color = radarRainbow and rainbowColor or Color3.fromRGB(255,50,50)
	local myPos = myRoot.Position; local myCFrame = myRoot.CFrame
	local dotIndex = 1
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		if not player.Character then continue end
		local root = player.Character:FindFirstChild("HumanoidRootPart")
		if not root then continue end
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		local isDead = humanoid and humanoid.Health <= 0
		local diff = root.Position - myPos
		local distance = diff.Magnitude
		if distance > radarRange then continue end
		local relX = myCFrame.RightVector:Dot(diff)
		local relZ = myCFrame.LookVector:Dot(diff)
		local scale = (distance / radarRange) * radius
		local angle = math.atan2(relX, relZ)
		local dotPos = Vector2.new(centerX + math.sin(angle) * scale, centerY - math.cos(angle) * scale)
		local fromCenter = dotPos - center
		if fromCenter.Magnitude > radius - 6 then dotPos = center + fromCenter.Unit * (radius - 6) end
		local dot, nameLabel, line = getOrCreateDot(dotIndex)
		local dotColor = isDead and Color3.fromRGB(100,100,100) or (radarRainbow and rainbowColor or Color3.fromRGB(255,50,50))
		dot.Position = dotPos; dot.Color = dotColor; dot.Visible = true
		if radarShowNames then
			nameLabel.Text = player.Name .. " [" .. math.floor(distance) .. "]"
			nameLabel.Position = Vector2.new(dotPos.X, dotPos.Y - 14)
			nameLabel.Color = radarRainbow and rainbowColor or Color3.fromRGB(255,255,255)
			nameLabel.Visible = true
		else nameLabel.Visible = false end
		if radarShowLines then
			line.From = center; line.To = dotPos; line.Color = dotColor; line.Visible = true
		else line.Visible = false end
		dotIndex = dotIndex + 1
	end
	hideDotsFrom(dotIndex)
end)

