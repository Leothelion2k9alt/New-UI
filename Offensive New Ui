Tabs.Movement:CreateToggle({ Name = "Loop Through All Waypoints", CurrentValue = false, Flag = "WaypointLoopToggle",
	Callback = function(v)
		waypointLoopEnabled = v
		if v then
			local hasAny = false
			for i = 1, maxWaypoints do if waypoints[i] then hasAny = true; break end end
			if not hasAny then
				Rayfield:Notify({Title = "Waypoints", Content = "No waypoints saved!", Duration = 2})
				Rayfield.Flags.WaypointLoopToggle:Set(false); return
			end
			local currentIndex = 1
			waypointLoopConnection = RunService.Heartbeat:Connect(function()
				if not waypointLoopEnabled then return end
				local root = getRoot(); if not root then return end
				local checked = 0
				while not waypoints[currentIndex] and checked < maxWaypoints do
					currentIndex = currentIndex % maxWaypoints + 1; checked = checked + 1
				end
				if not waypoints[currentIndex] then return end
				root.CFrame = waypoints[currentIndex].cframe
				currentIndex = currentIndex % maxWaypoints + 1
				task.wait(waypointLoopDelay)
			end)
			Rayfield:Notify({Title = "Waypoints", Content = "Looping through waypoints!", Duration = 2})
		else
			if waypointLoopConnection then waypointLoopConnection:Disconnect(); waypointLoopConnection = nil end
			Rayfield:Notify({Title = "Waypoints", Content = "Stopped looping!", Duration = 2})
		end
	end })

